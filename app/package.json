{
  "name": "wildbound-app",
  "version": "0.2.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "game": "npm --prefix ../game run build:app",
    "prestart": "npm run game",
    "start": "expo start",
    "ios": "npm run game && expo start --ios",
    "typecheck": "tsc --noEmit",
    "eas-build-post-install": "npm --prefix ../game ci && npm --prefix ../game run build:app"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.26",
    "expo-haptics": "~57.0.3",
    "expo-keep-awake": "~57.0.2",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "typescript": "~5.9.2"
  }
}
